{
  "version": 2,
  "buildCommand": "echo 'No build step required'",
  "outputDirectory": ".",

  "rewrites": [
    { "source": "/",              "destination": "/site/libertrip.html" },
    { "source": "/roadbook/:id",  "destination": "/roadbook.html"       },
    { "source": "/mes-roadbooks", "destination": "/mes-roadbooks.html"  },
    { "source": "/admin",         "destination": "/admin.html"           }
  ],

  "headers": [
    {
      "source": "/(.*)\\.html",
      "headers": [
        { "key": "Content-Type", "value": "text/html; charset=utf-8" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Content-Type", "value": "text/html; charset=utf-8" }
      ]
    },
    {
      "source": "/roadbook/(.*)",
      "headers": [
        { "key": "Content-Type", "value": "text/html; charset=utf-8" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options",        "value": "DENY" },
        { "key": "X-XSS-Protection",       "value": "1; mode=block" }
      ]
    },
    {
      "source": "/api/webhook-stripe",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ],

  "functions": {
    "api/generate.js":        { "maxDuration": 30 },
    "api/generate-full.js":   { "maxDuration": 60 },
    "api/roadbook.js":        { "maxDuration": 10 },
    "api/stripe-webhook.js":  { "maxDuration": 15 },
    "api/auth-magic-link.js": { "maxDuration": 10 },
    "api/my-roadbooks.js":    { "maxDuration": 10 },
    "api/admin.js":           { "maxDuration": 10 }
  }
}
